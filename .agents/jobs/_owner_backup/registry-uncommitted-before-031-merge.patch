+def configure_tmp(etc_path: Path) -> None:
+    """Mount ``/tmp`` on the Windows user's temporary directory.
+
+    Parameters
+    ----------
+    etc_path : Path
+        The installation's ``etc`` directory.
+
+    Raises
+    ------
+    RuntimeError
+        If the mount table is unavailable.
+    """
+    fstab_path = etc_path / "fstab"
+    if not fstab_path.is_file():
+        raise RuntimeError(f"MSYS2 mount table was not found: {fstab_path}")
+
+    # Replace an existing /tmp mount line, or append one, keeping the file's
+    # line endings and every other mount as supplied by MSYS2.
+    contents = fstab_path.read_bytes().decode("utf-8")
+    newline = "\r\n" if "\r\n" in contents else "\n"
+    updated_contents, replacements = re.subn(
+        r"^[ \t]*\S+[ \t]+/tmp[ \t][^\r\n]*(\r?)$",
+        lambda match: TMP_MOUNT + match.group(1),
+        contents,
+        count=1,
+        flags=re.MULTILINE,
+    )
+    if not replacements:
+        if updated_contents and not updated_contents.endswith("\n"):
+            updated_contents += newline
+        updated_contents += TMP_MOUNT + newline
+
+    # Avoid touching the file when MSYS2 already has the desired mount.
+    if updated_contents != contents:
+        fstab_path.write_bytes(updated_contents.encode("utf-8"))
+        print(f"Mounted /tmp on the user's temporary directory in {fstab_path}")
+    else:
+        print(f"/tmp is already mounted on the user's temporary directory in {fstab_path}")
+
+
+def main() -> int:
